[debug] [2026-07-20T16:20:56.830Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/habitlegends-3b9e7/rulesets {"name":"projects/habitlegends-3b9e7/rulesets/4947e809-be6f-4b0e-802e-47ca3fafb90e","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function ownsUser(userId) {\n      return signedIn() && request.auth.uid == userId;\n    }\n\n    function validDifficultyReward(data) {\n      return (data.difficulty == 'common' && data.xpReward == 40 && data.goldReward == 15)\n        || (data.difficulty == 'rare' && data.xpReward == 90 && data.goldReward == 35)\n        || (data.difficulty == 'epic' && data.xpReward == 150 && data.goldReward == 60)\n        || (data.difficulty == 'legendary' && data.xpReward == 250 && data.goldReward == 100);\n    }\n\n    function validTask(data, userId) {\n      return data.keys().hasAll([\n          'userId', 'title', 'description', 'category', 'difficulty', 'frequency',\n          'xpReward', 'goldReward', 'isActive', 'createdAt', 'updatedAt'\n        ])\n        && data.userId == userId\n        && data.title is string && data.title.size() >= 2 && data.title.size() <= 80\n        && data.description is string && data.description.size() <= 240\n        && data.category is string\n        && data.difficulty in ['common', 'rare', 'epic', 'legendary']\n        && data.frequency in ['once', 'daily', 'weekly']\n        && data.isActive is bool\n        && data.xpReward is int && data.goldReward is int\n        && validDifficultyReward(data);\n    }\n\n    match /users/{userId} {\n      allow create: if ownsUser(userId);\n      allow read, update, delete: if ownsUser(userId);\n\n      match /tasks/{taskId} {\n        allow read: if ownsUser(userId);\n        allow create: if ownsUser(userId) && validTask(request.resource.data, userId);\n        allow update: if ownsUser(userId)\n          && validTask(request.resource.data, userId)\n          && request.resource.data.userId == resource.data.userId\n          && request.resource.data.createdAt == resource.data.createdAt;\n        allow delete: if ownsUser(userId);\n      }\n    }\n\n    match /questTemplates/{questId} {\n      allow read: if signedIn();\n      allow write: if false;\n    }\n\n    match /storeItems/{itemId} {\n      allow read: if signedIn();\n      allow write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-07-20T16:20:56.032703Z","metadata":{"services":["cloud.firestore"]}}
