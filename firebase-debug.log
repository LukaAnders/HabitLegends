[debug] [2026-07-20T16:38:53.399Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/habitlegends-3b9e7/rulesets {"name":"projects/habitlegends-3b9e7/rulesets/e7674825-ac19-491c-b016-58eb1b519478","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function ownsUser(userId) {\n      return signedIn() && request.auth.uid == userId;\n    }\n\n    function validDifficultyReward(data) {\n      return (data.difficulty == 'common' && data.xpReward == 40 && data.goldReward == 15)\n        || (data.difficulty == 'rare' && data.xpReward == 90 && data.goldReward == 35)\n        || (data.difficulty == 'epic' && data.xpReward == 150 && data.goldReward == 60)\n        || (data.difficulty == 'legendary' && data.xpReward == 250 && data.goldReward == 100);\n    }\n\n    function validTask(data, userId) {\n      return data.keys().hasAll([\n          'userId', 'title', 'description', 'category', 'difficulty', 'frequency',\n          'xpReward', 'goldReward', 'isActive', 'createdAt', 'updatedAt'\n        ])\n        && data.userId == userId\n        && data.title is string && data.title.size() >= 2 && data.title.size() <= 80\n        && data.description is string && data.description.size() <= 240\n        && data.category is string\n        && data.difficulty in ['common', 'rare', 'epic', 'legendary']\n        && data.frequency in ['once', 'daily', 'weekly']\n        && data.isActive is bool\n        && data.xpReward is int && data.goldReward is int\n        && validDifficultyReward(data);\n    }\n\n    function validCompletion(data) {\n      return data.keys().hasAll([\n          'taskId', 'taskTitle', 'difficulty', 'category', 'xpEarned',\n          'goldEarned', 'levelBonusGold', 'periodKey', 'completedAt'\n        ])\n        && data.taskId is string && data.taskTitle is string\n        && data.category is string && data.periodKey is string\n        && data.difficulty in ['common', 'rare', 'epic', 'legendary']\n        && data.xpEarned is int && data.goldEarned is int && data.levelBonusGold is int\n        && data.levelBonusGold >= 0\n        && ((data.difficulty == 'common' && data.xpEarned == 40 && data.goldEarned == 15)\n          || (data.difficulty == 'rare' && data.xpEarned == 90 && data.goldEarned == 35)\n          || (data.difficulty == 'epic' && data.xpEarned == 150 && data.goldEarned == 60)\n          || (data.difficulty == 'legendary' && data.xpEarned == 250 && data.goldEarned == 100));\n    }\n\n    function validInventoryItem(data, itemId) {\n      return data.keys().hasAll([\n          'itemId', 'name', 'category', 'rarity', 'imageUrl',\n          'purchasedPrice', 'purchasedAt', 'equipped'\n        ])\n        && data.itemId == itemId && data.name is string && data.imageUrl is string\n        && data.category in ['hair', 'outfit', 'weapon', 'accessory', 'pet', 'background']\n        && data.rarity in ['common', 'rare', 'epic', 'legendary']\n        && data.purchasedPrice is int && data.purchasedPrice >= 0\n        && data.equipped == false;\n    }\n\n    match /users/{userId} {\n      allow create: if ownsUser(userId);\n      allow read, update, delete: if ownsUser(userId);\n\n      match /tasks/{taskId} {\n        allow read: if ownsUser(userId);\n        allow create: if ownsUser(userId) && validTask(request.resource.data, userId);\n        allow update: if ownsUser(userId)\n          && validTask(request.resource.data, userId)\n          && request.resource.data.userId == resource.data.userId\n          && request.resource.data.createdAt == resource.data.createdAt;\n        allow delete: if ownsUser(userId);\n      }\n\n      match /taskCompletions/{completionId} {\n        allow read: if ownsUser(userId);\n        allow create: if ownsUser(userId) && validCompletion(request.resource.data);\n        allow update, delete: if false;\n      }\n\n      match /inventory/{itemId} {\n        allow read: if ownsUser(userId);\n        allow create: if ownsUser(userId) && validInventoryItem(request.resource.data, itemId);\n        allow update, delete: if false;\n      }\n    }\n\n    match /questTemplates/{questId} {\n      allow read: if signedIn();\n      allow write: if false;\n    }\n\n    match /storeItems/{itemId} {\n      allow read: if signedIn();\n      allow write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-07-20T16:38:52.598383Z","metadata":{"services":["cloud.firestore"]}}
