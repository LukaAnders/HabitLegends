rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Modelo: perfis privados em users/{uid}; tarefas, conclusões e inventário
    // pertencem ao mesmo uid. Catálogo e modelos são somente leitura no cliente.
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validAvatarValue(value) {
      return value == null || (value is string && value.size() >= 1 && value.size() <= 100);
    }

    function validAvatar(data) {
      return data is map
        && data.keys().hasAll(['body', 'hair', 'outfit', 'weapon', 'accessory', 'pet', 'background'])
        && data.keys().hasOnly(['body', 'hair', 'outfit', 'weapon', 'accessory', 'pet', 'background'])
        && validAvatarValue(data.body) && validAvatarValue(data.hair)
        && validAvatarValue(data.outfit) && validAvatarValue(data.weapon)
        && validAvatarValue(data.accessory) && validAvatarValue(data.pet)
        && validAvatarValue(data.background);
    }

    function validPlayer(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'email', 'photoURL', 'characterName', 'title',
          'level', 'currentXp', 'totalXp', 'gold', 'streak', 'longestStreak',
          'completedTasks', 'lastActiveDate', 'avatar', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'email', 'photoURL', 'characterName', 'title',
          'level', 'currentXp', 'totalXp', 'gold', 'streak', 'longestStreak',
          'completedTasks', 'lastActiveDate', 'avatar', 'createdAt', 'updatedAt',
          'lastActionId', 'lastActionType'
        ])
        && data.uid == userId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.email is string && data.email.size() <= 254
        && (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 2048))
        && data.characterName is string && data.characterName.size() >= 1 && data.characterName.size() <= 80
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 80
        && data.level is int && data.level >= 1 && data.level <= 10000
        && data.currentXp is int && data.currentXp >= 0
        && data.totalXp is int && data.totalXp >= 0 && data.totalXp <= 1000000000
        && data.gold is int && data.gold >= 0 && data.gold <= 1000000000
        && data.streak is int && data.streak >= 0 && data.streak <= 1000000
        && data.longestStreak is int && data.longestStreak >= data.streak && data.longestStreak <= 1000000
        && data.completedTasks is int && data.completedTasks >= 0 && data.completedTasks <= 1000000000
        && (data.lastActiveDate == null || data.lastActiveDate is timestamp)
        && (!('lastActionId' in data) || (data.lastActionId is string && data.lastActionId.size() >= 1 && data.lastActionId.size() <= 160))
        && (!('lastActionType' in data) || data.lastActionType in ['completion', 'purchase', 'journey', 'achievement', 'daily_reward'])
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && validAvatar(data.avatar);
    }

    function validNewPlayer(data, userId) {
      return validPlayer(data, userId)
        && !('lastActionId' in data) && !('lastActionType' in data)
        && data.uid == request.auth.uid && data.title == 'Aventureiro Iniciante'
        && data.level == 1 && data.currentXp == 0 && data.totalXp == 0
        && data.gold == 100 && data.streak == 0 && data.longestStreak == 0
        && data.completedTasks == 0 && data.lastActiveDate == null
        && data.createdAt == request.time && data.updatedAt == request.time;
    }

    function validCosmeticPlayerUpdate(userId) {
      return validPlayer(request.resource.data, userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'characterName', 'email', 'photoURL', 'avatar', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;
    }

    function xpFloorForLevel(level) {
      return (level - 1) * 100 + ((level - 1) * (level - 2) * 25);
    }

    function validLevelProgress(data) {
      return data.totalXp == xpFloorForLevel(data.level) + data.currentXp
        && data.currentXp < 100 + ((data.level - 1) * 50);
    }

    function validCompletionPlayerUpdate(userId) {
      let actionId = request.resource.data.lastActionId;
      let completionPath = /databases/$(database)/documents/users/$(userId)/taskCompletions/$(actionId);
      let completion = getAfter(completionPath).data;
      return request.resource.data.lastActionType == 'completion'
        && (!('lastActionId' in resource.data) || actionId != resource.data.lastActionId)
        && existsAfter(completionPath)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'level', 'currentXp', 'totalXp', 'gold', 'streak', 'longestStreak',
          'completedTasks', 'lastActiveDate', 'lastActionId', 'lastActionType', 'updatedAt'
        ])
        && request.resource.data.totalXp == resource.data.totalXp + completion.xpEarned
        && request.resource.data.completedTasks == resource.data.completedTasks + 1
        && request.resource.data.level is int
        && request.resource.data.currentXp is int && request.resource.data.currentXp >= 0
        && request.resource.data.totalXp is int && request.resource.data.totalXp >= 0
        && request.resource.data.gold is int && request.resource.data.gold >= 0
        && request.resource.data.streak is int && request.resource.data.streak >= 0
        && request.resource.data.longestStreak is int
        && request.resource.data.completedTasks is int
        && request.resource.data.level >= resource.data.level
        && completion.levelBonusGold == (request.resource.data.level - resource.data.level) * 50
        && request.resource.data.gold == resource.data.gold + completion.goldEarned + completion.levelBonusGold
        && validLevelProgress(request.resource.data)
        && request.resource.data.streak in [1, resource.data.streak, resource.data.streak + 1]
        && request.resource.data.longestStreak in [resource.data.longestStreak, request.resource.data.streak]
        && request.resource.data.lastActiveDate is timestamp
        && request.resource.data.updatedAt == request.time;
    }

    function validPurchasePlayerUpdate(userId) {
      let itemId = request.resource.data.lastActionId;
      let itemPath = /databases/$(database)/documents/storeItems/$(itemId);
      let inventoryPath = /databases/$(database)/documents/users/$(userId)/inventory/$(itemId);
      let item = get(itemPath).data;
      return request.resource.data.lastActionType == 'purchase'
        && (!('lastActionId' in resource.data) || itemId != resource.data.lastActionId)
        && existsAfter(inventoryPath)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'gold', 'lastActionId', 'lastActionType', 'updatedAt'
        ])
        && request.resource.data.gold is int && request.resource.data.gold >= 0
        && item.isAvailable == true
        && resource.data.level >= item.requiredLevel
        && resource.data.gold >= item.price
        && request.resource.data.gold == resource.data.gold - item.price
        && request.resource.data.updatedAt == request.time;
    }

    function validJourneyPlayerUpdate(userId) {
      let regionId = request.resource.data.lastActionId;
      let region = get(/databases/$(database)/documents/journeyRegions/$(regionId)).data;
      let progressPath = /databases/$(database)/documents/users/$(userId)/journey/$(regionId);
      return request.resource.data.lastActionType == 'journey'
        && (!('lastActionId' in resource.data) || regionId != resource.data.lastActionId)
        && existsAfter(progressPath)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'level', 'currentXp', 'totalXp', 'gold', 'title',
          'lastActionId', 'lastActionType', 'updatedAt'
        ])
        && request.resource.data.level is int
        && request.resource.data.currentXp is int && request.resource.data.currentXp >= 0
        && request.resource.data.totalXp is int && request.resource.data.totalXp >= 0
        && request.resource.data.gold is int && request.resource.data.gold >= 0
        && request.resource.data.title is string
        && resource.data.level >= region.minimumLevel
        && request.resource.data.totalXp == resource.data.totalXp + region.reward.xp
        && request.resource.data.gold == resource.data.gold + region.reward.gold
        && request.resource.data.level >= resource.data.level
        && validLevelProgress(request.resource.data)
        && ((region.reward.title == null && request.resource.data.title == resource.data.title)
          || (region.reward.title is string && request.resource.data.title == region.reward.title))
        && request.resource.data.updatedAt == request.time;
    }

    function validAchievementPlayerUpdate(userId) {
      let achievementId = request.resource.data.lastActionId;
      let achievement = get(/databases/$(database)/documents/achievements/$(achievementId)).data;
      let progressPath = /databases/$(database)/documents/users/$(userId)/achievements/$(achievementId);
      return request.resource.data.lastActionType == 'achievement'
        && existsAfter(progressPath) && getAfter(progressPath).data.rewardClaimed == true
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'level', 'currentXp', 'totalXp', 'gold', 'title', 'lastActionId', 'lastActionType', 'updatedAt'
        ])
        && request.resource.data.totalXp == resource.data.totalXp + achievement.reward.xp
        && request.resource.data.gold == resource.data.gold + achievement.reward.gold
        && request.resource.data.level >= resource.data.level
        && validLevelProgress(request.resource.data)
        && ((achievement.reward.titleId == null && request.resource.data.title == resource.data.title)
          || (achievement.reward.titleId is string && request.resource.data.title == achievement.reward.titleId))
        && request.resource.data.updatedAt == request.time;
    }

    function validDailyRewardPlayerUpdate(userId) {
      let dateKey = request.resource.data.lastActionId;
      let rewardPath = /databases/$(database)/documents/users/$(userId)/dailyRewards/$(dateKey);
      return request.resource.data.lastActionType == 'daily_reward'
        && existsAfter(rewardPath) && getAfter(rewardPath).data.xp == 200 && getAfter(rewardPath).data.gold == 100
        && request.resource.data.uid == resource.data.uid && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['level','currentXp','totalXp','gold','lastActionId','lastActionType','updatedAt'])
        && request.resource.data.totalXp == resource.data.totalXp + 200 && request.resource.data.gold == resource.data.gold + 100
        && request.resource.data.level >= resource.data.level && validLevelProgress(request.resource.data)
        && request.resource.data.updatedAt == request.time;
    }

    function validDailyReward(data, userId, dateKey) {
      let player = getAfter(/databases/$(database)/documents/users/$(userId)).data;
      return dateKey.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && data.keys().hasAll(['dateKey','completedTasks','targetTasks','xp','gold','claimedAt'])
        && data.keys().hasOnly(['dateKey','completedTasks','targetTasks','xp','gold','claimedAt'])
        && data.dateKey == dateKey && data.completedTasks is int && data.targetTasks is int
        && data.targetTasks > 0 && data.completedTasks >= data.targetTasks
        && data.xp == 200 && data.gold == 100 && data.claimedAt == request.time
        && player.lastActionType == 'daily_reward' && player.lastActionId == dateKey;
    }

    function validAchievementUnlock(data, achievementId) {
      let definition = get(/databases/$(database)/documents/achievements/$(achievementId)).data;
      return data.keys().hasAll(['achievementId','currentProgress','target','unlocked','unlockedAt','rewardClaimed','rewardClaimedAt','updatedAt'])
        && data.keys().hasOnly(['achievementId','currentProgress','target','unlocked','unlockedAt','rewardClaimed','rewardClaimedAt','updatedAt'])
        && data.achievementId == achievementId && data.currentProgress is int
        && data.currentProgress >= definition.requirement.target && data.target == definition.requirement.target
        && data.unlocked == true && data.unlockedAt == request.time
        && data.rewardClaimed == false && data.rewardClaimedAt == null && data.updatedAt == request.time;
    }

    function validAchievementClaim(data, userId, achievementId) {
      let player = getAfter(/databases/$(database)/documents/users/$(userId)).data;
      return data.achievementId == resource.data.achievementId && data.target == resource.data.target
        && data.currentProgress == resource.data.currentProgress && data.unlocked == resource.data.unlocked
        && data.unlockedAt == resource.data.unlockedAt
        && resource.data.unlocked == true && resource.data.rewardClaimed == false
        && data.rewardClaimed == true && data.rewardClaimedAt == request.time && data.updatedAt == request.time
        && data.diff(resource.data).affectedKeys().hasOnly(['rewardClaimed','rewardClaimedAt','updatedAt'])
        && player.lastActionType == 'achievement' && player.lastActionId == achievementId;
    }

    function validAchievementActivity(data, userId, activityId) {
      let achievementId = data.metadata.achievementId;
      let definition = get(/databases/$(database)/documents/achievements/$(achievementId)).data;
      let progress = getAfter(/databases/$(database)/documents/users/$(userId)/achievements/$(achievementId)).data;
      return data.keys().hasAll(['type','title','description','metadata','createdAt'])
        && data.keys().hasOnly(['type','title','description','metadata','createdAt'])
        && data.type in ['achievement_unlocked','achievement_reward_claimed']
        && data.title is string && data.title.size() <= 140 && data.description is string && data.description.size() <= 300
        && data.metadata.keys().hasOnly(['achievementId','achievementName','rarity','xp','gold'])
        && data.metadata.achievementName == definition.name && data.metadata.rarity == definition.rarity
        && data.metadata.xp == definition.reward.xp && data.metadata.gold == definition.reward.gold
        && data.createdAt == request.time
        && ((data.type == 'achievement_unlocked' && activityId == 'achievement_unlocked_' + achievementId && progress.unlocked == true)
          || (data.type == 'achievement_reward_claimed' && activityId == 'achievement_reward_' + achievementId && progress.rewardClaimed == true));
    }

    function validActivityBase(data) {
      return data.keys().hasAll(['type','title','description','metadata','createdAt'])
        && data.keys().hasOnly(['type','title','description','metadata','createdAt'])
        && data.type is string && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 300
        && data.metadata is map && data.metadata.size() <= 10 && data.createdAt == request.time;
    }

    function validCompletionActivity(data, userId, activityId) {
      let completionId = data.metadata.completionId;
      let completion = getAfter(/databases/$(database)/documents/users/$(userId)/taskCompletions/$(completionId)).data;
      let player = getAfter(/databases/$(database)/documents/users/$(userId)).data;
      return validActivityBase(data) && completionId is string
        && ((data.type == 'task_completed' && activityId == 'task_completed_' + completionId
          && data.metadata.taskId == completion.taskId && data.metadata.taskName == completion.taskTitle
          && data.metadata.xp == completion.xpEarned && data.metadata.gold == completion.goldEarned
          && data.metadata.difficulty == completion.difficulty && data.metadata.category == completion.category)
        || (data.type == 'level_up' && activityId == 'level_up_' + completionId && data.metadata.level == player.level)
        || (data.type == 'streak_milestone' && activityId == 'streak_milestone_' + completionId && data.metadata.streak == player.longestStreak));
    }

    function validMarketActivity(data, userId, activityId) {
      let itemId = data.metadata.itemId;
      let item = get(/databases/$(database)/documents/storeItems/$(itemId)).data;
      let inventory = getAfter(/databases/$(database)/documents/users/$(userId)/inventory/$(itemId)).data;
      return validActivityBase(data) && itemId is string
        && data.metadata.itemName == item.name && data.metadata.category == item.category
        && ((data.type == 'item_purchased' && activityId == 'item_purchased_' + itemId
          && data.metadata.rarity == item.rarity && data.metadata.gold == item.price && inventory.purchasedPrice == item.price)
        || (data.type == 'item_equipped' && activityId.matches('item_equipped_' + itemId + '_.*') && inventory.equipped == true));
    }

    function validJourneyProgress(data, userId, regionId) {
      let region = get(/databases/$(database)/documents/journeyRegions/$(regionId)).data;
      let player = getAfter(/databases/$(database)/documents/users/$(userId)).data;
      return data.keys().hasAll([
          'regionId', 'status', 'rewardClaimed', 'objectivesSnapshot',
          'completedAt', 'claimedAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'regionId', 'status', 'rewardClaimed', 'objectivesSnapshot',
          'completedAt', 'claimedAt', 'updatedAt'
        ])
        && data.regionId == regionId && data.status == 'completed' && data.rewardClaimed == true
        && data.objectivesSnapshot is map && data.objectivesSnapshot.size() <= 10
        && data.completedAt == request.time && data.claimedAt == request.time && data.updatedAt == request.time
        && player.lastActionType == 'journey' && player.lastActionId == regionId
        && player.level >= region.minimumLevel
        && (region.previousRegionId == null
          || (exists(/databases/$(database)/documents/users/$(userId)/journey/$(region.previousRegionId))
            && get(/databases/$(database)/documents/users/$(userId)/journey/$(region.previousRegionId)).data.rewardClaimed == true));
    }

    function validJourneyActivity(data, userId, activityId) {
      let regionId = data.metadata.regionId;
      let progressPath = /databases/$(database)/documents/users/$(userId)/journey/$(regionId);
      let region = get(/databases/$(database)/documents/journeyRegions/$(regionId)).data;
      return data.keys().hasAll(['type', 'title', 'description', 'metadata', 'createdAt'])
        && data.keys().hasOnly(['type', 'title', 'description', 'metadata', 'createdAt'])
        && data.type in ['journey_region_completed', 'journey_completed']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 300
        && data.metadata is map && data.metadata.keys().hasOnly(['regionId', 'xp', 'gold', 'title'])
        && regionId is string && activityId == 'journey_' + regionId
        && data.metadata.xp == region.reward.xp && data.metadata.gold == region.reward.gold
        && data.metadata.title == region.reward.title
        && data.createdAt == request.time
        && existsAfter(progressPath) && getAfter(progressPath).data.rewardClaimed == true;
    }

    function validDifficultyReward(data) {
      return (data.difficulty == 'common' && data.xpReward == 40 && data.goldReward == 15)
        || (data.difficulty == 'rare' && data.xpReward == 90 && data.goldReward == 35)
        || (data.difficulty == 'epic' && data.xpReward == 150 && data.goldReward == 60)
        || (data.difficulty == 'legendary' && data.xpReward == 250 && data.goldReward == 100);
    }

    function validTask(data, userId) {
      return data.keys().hasAll([
          'userId', 'title', 'description', 'category', 'difficulty', 'frequency',
          'xpReward', 'goldReward', 'isActive', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'title', 'description', 'category', 'difficulty', 'frequency',
          'weekDays', 'dueDate', 'xpReward', 'goldReward', 'isActive', 'createdAt', 'updatedAt'
        ])
        && data.userId == userId
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 80
        && data.description is string && data.description.size() <= 240
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 50
        && data.difficulty in ['common', 'rare', 'epic', 'legendary']
        && data.frequency in ['once', 'daily', 'weekly']
        && (!('weekDays' in data) || (data.weekDays is list && data.weekDays.size() <= 7))
        && (!('dueDate' in data) || data.dueDate == null || data.dueDate is timestamp)
        && data.isActive is bool && data.xpReward is int && data.goldReward is int
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && validDifficultyReward(data);
    }

    function validCompletion(data, userId, completionId) {
      let taskPath = /databases/$(database)/documents/users/$(userId)/tasks/$(data.taskId);
      let task = get(taskPath).data;
      return data.keys().hasAll([
          'taskId', 'taskTitle', 'difficulty', 'category', 'xpEarned',
          'goldEarned', 'levelBonusGold', 'periodKey', 'completedAt'
        ])
        && data.keys().hasOnly([
          'taskId', 'taskTitle', 'difficulty', 'category', 'xpEarned',
          'goldEarned', 'levelBonusGold', 'periodKey', 'completedAt'
        ])
        && exists(taskPath) && task.isActive == true
        && completionId == data.taskId + '_' + data.periodKey
        && data.taskId is string && data.taskId.size() >= 1 && data.taskId.size() <= 100
        && data.taskTitle == task.title && data.category == task.category
        && data.difficulty == task.difficulty
        && data.periodKey is string && data.periodKey.size() >= 4 && data.periodKey.size() <= 60
        && data.xpEarned == task.xpReward && data.goldEarned == task.goldReward
        && data.levelBonusGold is int && data.levelBonusGold >= 0 && data.levelBonusGold <= 500
        && data.completedAt == request.time;
    }

    function validInventoryItem(data, itemId) {
      return data.keys().hasAll([
          'itemId', 'name', 'category', 'rarity', 'imageUrl',
          'purchasedPrice', 'purchasedAt', 'equipped'
        ])
        && data.keys().hasOnly([
          'itemId', 'name', 'category', 'rarity', 'imageUrl',
          'purchasedPrice', 'purchasedAt', 'equipped', 'avatarSlot', 'avatarTransform'
        ])
        && data.itemId == itemId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 2048
        && data.category in ['hair', 'outfit', 'weapon', 'accessory', 'pet', 'background']
        && data.rarity in ['common', 'rare', 'epic', 'legendary']
        && data.purchasedPrice is int && data.purchasedPrice >= 0
        && data.purchasedAt is timestamp && data.equipped is bool
        && (!('avatarSlot' in data) || data.avatarSlot in ['background','body','outfit','hair','faceAccessory','chestAccessory','backAccessory','leftHandWeapon','rightHandWeapon','pet','foreground'])
        && (!('avatarTransform' in data) || (data.avatarTransform is map
          && data.avatarTransform.keys().hasAll(['x','y','scale','rotation'])
          && data.avatarTransform.keys().hasOnly(['x','y','scale','rotation','flipX'])
          && data.avatarTransform.x is number && data.avatarTransform.y is number
          && data.avatarTransform.scale is number && data.avatarTransform.rotation is number
          && (!('flipX' in data.avatarTransform) || data.avatarTransform.flipX is bool)));
    }

    function validInventoryPurchase(data, userId, itemId) {
      let item = get(/databases/$(database)/documents/storeItems/$(itemId)).data;
      let player = getAfter(/databases/$(database)/documents/users/$(userId)).data;
      return validInventoryItem(data, itemId)
        && player.lastActionType == 'purchase' && player.lastActionId == itemId
        && data.name == item.name && data.category == item.category
        && data.rarity == item.rarity && data.imageUrl == item.imageUrl
        && data.avatarSlot == item.avatarSlot
        && ((!('avatarTransform' in item) && !('avatarTransform' in data)) || data.avatarTransform == item.avatarTransform)
        && data.purchasedPrice == item.price && data.purchasedAt == request.time
        && data.equipped == false;
    }

    match /users/{userId} {
      allow create: if ownsUser(userId) && validNewPlayer(request.resource.data, userId);
      allow read: if ownsUser(userId);
      allow update: if ownsUser(userId) && (
        validCosmeticPlayerUpdate(userId)
          || (request.resource.data.lastActionType == 'completion'
            && validCompletionPlayerUpdate(userId))
          || (request.resource.data.lastActionType == 'purchase'
            && validPurchasePlayerUpdate(userId))
          || (request.resource.data.lastActionType == 'journey'
            && validJourneyPlayerUpdate(userId))
          || (request.resource.data.lastActionType == 'achievement'
            && validAchievementPlayerUpdate(userId))
          || (request.resource.data.lastActionType == 'daily_reward'
            && validDailyRewardPlayerUpdate(userId)));
      allow delete: if false;

      match /tasks/{taskId} {
        allow read: if ownsUser(userId);
        allow create: if ownsUser(userId) && validTask(request.resource.data, userId)
          && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
        allow update: if ownsUser(userId) && validTask(request.resource.data, userId)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if ownsUser(userId);
      }

      match /taskCompletions/{completionId} {
        allow read: if ownsUser(userId);
        allow create: if ownsUser(userId)
          && validCompletion(request.resource.data, userId, completionId)
          && getAfter(/databases/$(database)/documents/users/$(userId)).data.lastActionId == completionId
          && getAfter(/databases/$(database)/documents/users/$(userId)).data.lastActionType == 'completion';
        allow update, delete: if false;
      }

      match /inventory/{itemId} {
        allow read: if ownsUser(userId);
        allow create: if ownsUser(userId) && validInventoryPurchase(request.resource.data, userId, itemId);
        allow update: if ownsUser(userId)
          && validInventoryItem(request.resource.data, itemId)
          && request.resource.data.purchasedAt == resource.data.purchasedAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['equipped']);
        allow delete: if false;
      }

      match /journey/{regionId} {
        allow read: if ownsUser(userId);
        allow create: if ownsUser(userId)
          && validJourneyProgress(request.resource.data, userId, regionId);
        allow update, delete: if false;
      }

      match /activityLog/{activityId} {
        allow read: if ownsUser(userId);
        allow create: if ownsUser(userId) && (
          (request.resource.data.type in ['journey_region_completed','journey_completed'] && validJourneyActivity(request.resource.data, userId, activityId))
          || (request.resource.data.type in ['achievement_unlocked','achievement_reward_claimed'] && validAchievementActivity(request.resource.data, userId, activityId))
          || (request.resource.data.type in ['task_completed','level_up','streak_milestone'] && validCompletionActivity(request.resource.data, userId, activityId))
          || (request.resource.data.type in ['item_purchased','item_equipped'] && validMarketActivity(request.resource.data, userId, activityId)));
        allow update, delete: if false;
      }

      match /achievements/{achievementId} {
        allow read: if ownsUser(userId);
        allow create: if ownsUser(userId) && validAchievementUnlock(request.resource.data, achievementId);
        allow update: if ownsUser(userId) && validAchievementClaim(request.resource.data, userId, achievementId);
        allow delete: if false;
      }

      match /dailyRewards/{dateKey} {
        allow read: if ownsUser(userId);
        allow create: if ownsUser(userId) && validDailyReward(request.resource.data, userId, dateKey);
        allow update, delete: if false;
      }
    }

    match /questTemplates/{questId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /storeItems/{itemId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /journeyRegions/{regionId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /achievements/{achievementId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
